{
  "manifest_version": 3,
  "name": "EchoProfile Browser Extension",
  "version": "0.1.0",
  "description": "Connects this browser to the local EchoProfile service for independent extension-backed control.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "debugger",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8756/*",
    "http://localhost:8756/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "EchoProfile Browser Extension"
  },
  "key": "",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src http://127.0.0.1:8756 ws://127.0.0.1:8756"
  }
}
